SEARXNG_URL=http://localhost:8080
# Pages fetched per search query
SEARXNG_MAX_RESULTS=10
# Relevant passages retained from each fetched page
SEARXNG_MAX_PASSAGES=3
# Comma-separated SearXNG language codes; "all" leaves locale selection to the
# upstream engines. Add explicit locales when a query needs targeted variants
# (for example: all,en,hu,de).
SEARXNG_LANGUAGES=all
OLLAMA_MODEL=ollama:gemma4:latest
EMBEDDING_MODEL=nomic-embed-text

# Only necessary for Open Agent Platform
SUPABASE_KEY=
SUPABASE_URL=
# Should be set to true for a production deployment on Open Agent Platform. Should be set to false otherwise, such as for local development.
GET_API_KEYS_FROM_CONFIG=false